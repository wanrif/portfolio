{
  "name": "portfolio",
  "version": "2.0.5",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -b && vp build",
    "dev": "bunx --bun vp dev --host",
    "format": "vp fmt",
    "format:check": "vp fmt --check",
    "format:lint": "vp fmt --check && bunx vp lint",
    "lint": "bunx vp lint",
    "lint:fix": "bunx vp lint --fix --fix-suggestions",
    "prepare": "vp config",
    "preview": "vp preview"
  },
  "dependencies": {
    "@gsap/react": "^2.1.2",
    "@tailwindcss/vite": "^4.3.3",
    "@toolwind/corner-shape": "^0.0.8-3",
    "clsx": "2.1.1",
    "framer-motion": "^13.4.4",
    "gsap": "^3.15.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-i18next": "^17.0.15",
    "react-icons": "^5.7.0",
    "tailwind-merge": "3.5.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@mdx-js/rollup": "^3.1.1",
    "@types/bun": "^1.4.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "autoprefixer": "^10.6.1",
    "rollup-plugin-visualizer": "^7.1.1",
    "tailwindcss": "^4.3.3",
    "terser": "^5.51.2",
    "typescript": "^6.0.3",
    "vite": "npm:@voidzero-dev/vite-plus-core@1.0.0",
    "vite-plus": "1.0.0"
  },
  "overrides": {
    "vite": "npm:@voidzero-dev/vite-plus-core@1.0.0"
  },
  "devEngines": {
    "packageManager": {
      "name": "bun",
      "version": "1.4.2",
      "onFail": "download"
    }
  },
  "packageManager": "bun@1.4.2"
}
